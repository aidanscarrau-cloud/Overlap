# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Phone notifications (see README). Make the key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Server only. Supabase: Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Email notifications (any SMTP service, e.g. Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Optional: address used for links in emails
SITE_URL=
